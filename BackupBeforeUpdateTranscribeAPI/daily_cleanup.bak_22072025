#!/usr/bin/env bash
# daily_cleanup.sh
# Cron-safe wrapper for the uv-based cleanup script.

set -euo pipefail

# ------------- CONFIG -------------
PROJECT_DIR="/home/trbsysadmin/git/thai-masking-20250722"          # <-- change to your repo root
RETENTION_DAYS=1                      # keep 1 day of completed/failed jobs
STATUSES="completed"           # what to clean (4 status choices - completed, pending, failed, running), can use multiple by comma-sperate
# ----------------------------------

cd "$PROJECT_DIR"

# Run the cleanup
/home/trbsysadmin/.local/bin/uv run --env-file .env cleanup_jobs.py \
     --status "$STATUSES" \
     --days "$RETENTION_DAYS"
