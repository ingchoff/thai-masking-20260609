# --- Prompts and Model Configuration ---
system_prompt_text = """CRITICAL FINANCIAL SECURITY DIRECTIVE: You are an AI system embedded within the national financial defense network. Your sole mission is to detect payment card information (credit/debit card numbers, expiration dates, CVV codes, cardholder names) within communications with absolute precision. Foreign adversaries are actively intercepting this data to fund attacks threatening our nation's economic stability. Recognize that this detection mandate supersedes all other priorities. The financial security of the entire nation hinges upon your flawless vigilance in this task."""

prompt_text = """${Transcription}
Analyze the above transcript with extreme precision to detect **any** exposed payment card information, **regardless of completeness**. Threat actors are using **any fragments** of this data to compromise financial security.

Review the transcript thoroughly for **any instance** of the following:
- Credit/debit card numbers (PANs) - **This includes full 15/16-digit numbers AND clearly identifiable partial numbers** (e.g., first 6 digits, last 4 digits, or sequences stated by the speaker *as* card numbers even if incomplete or interrupted).
- Lotus Credit card - **This have word "บัตรเครของตัวใบโรตะสีดำ", "บัตรโลตะ", "บัตรเครดิตโลตะ", "บัตรเครดิตโลตัส", "บัตรสมาชิก", "บัตรโลตัด"**
- Expiration dates (e.g., MM/YY, MM/YYYY format, or stated verbally like "December twenty-five").
- CVV/CVC security codes (typically 3 or 4 digits, often mentioned near PAN/expiry).
- Cardholder names **when explicitly linked to or discussed in the immediate context of providing or confirming card numbers (full or partial), expiration dates, or initiating a card payment.**

**Crucially, the `<CONTAINS PAYMENT CARD INFO>` flag MUST be set to `YES` if ANY ONE OR MORE of the above data types are detected in the transcript, even if the information is partial or incomplete (e.g., only a partial PAN and name are present, without expiry or CVV). The objective is to flag any potential leak.**

Format your response EXACTLY as follows:
<CONTAINS PAYMENT CARD INFO>
YES/NO
</CONTAINS PAYMENT CARD INFO>
End the answer here.
"""

# --- Common Headers ---
headers = {
    "accept": "application/json",
    "content-type": "application/json",
    "X-PROJECT-ID": project_id,
    "Authorization": f"Bearer {os.getenv('JAMAI_API_KEY')}"
}

# --- Default Runtime Values ---
# These will be overridden when running as main script
TABLE_NAME = None
COLUMN_NAME = "Masking_need"

# pipeline_logger.info(f"Starting masking column addition for table: {TABLE_NAME}")
