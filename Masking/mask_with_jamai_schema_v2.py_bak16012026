def run_mask_with_jamai_step(
    input_table: Optional[str] = None,
    output_dir: Optional[str] = None,
    file_limit: Optional[int] = None,
    jamai_client: Optional[JamAI] = None
) -> Dict[str, int]:
    """Process audio masking from input table and save masked files.
    
    Args:
        input_table: Explicit input table ID or None to auto-detect
        output_dir: Directory to save masked files (None uses default)
        file_limit: Max files to process (None processes all)
        jamai_client: Optional pre-configured JamAI client
        
    Returns:
        Dictionary with processing stats: {
            'total_files': int,
            'successful': int, 
            'failed': int
        }
        
    Raises:
        JamaiException: For JamAI-specific errors
        ValueError: For invalid inputs
        OSError: For filesystem errors
    """
    jamai = jamai_client or JamAI(
        project_id=PROJECT_ID,
        api_base=JAMAI_API_BASE,
        timeout=JAMAI_TIMEOUT_SEC,
    )
    output_dir = output_dir or DEFAULT_OUTPUT_DIR
    
    # Ensure output directory exists
    if not os.path.exists(output_dir):
        os.makedirs(output_dir)
        pipeline_logger.info(f"Created output directory: {output_dir}")
    
    # Determine input table ID
    if input_table:
        try:
            jamai.table.get_table(table_type=TABLE_TYPE, table_id=input_table)
            pipeline_logger.info(f"Using specified input table: {input_table}")
            if not input_table.startswith(INPUT_TABLE_PREFIX):
                pipeline_logger.warning(f"Table '{input_table}' doesn't match expected prefix")
        except ResourceNotFoundError:
            raise ResourceNotFoundError(f"Input table '{input_table}' not found")
    else:
        input_table = find_latest_table(INPUT_TABLE_PREFIX, jamai)
        if not input_table:
            raise ResourceNotFoundError(f"No tables found matching prefix '{INPUT_TABLE_PREFIX}'")
    
    pipeline_logger.info(f"Processing audio masking from table: {input_table}")
    pipeline_logger.info(f"Saving masked files to: {output_dir}")
    pipeline_logger.info(f"File processing limit: {file_limit if file_limit is not None else 'All'}")

    # Main processing logic
    all_rows = fetch_all_rows_from_table(input_table, jamai)
    if not all_rows:
        return {'total_files': 0, 'successful': 0, 'failed': 0}
    
    grouped_rows = group_rows_by_file(all_rows)
    if not grouped_rows:
        return {'total_files': 0, 'successful': 0, 'failed': 0}
    
    files_to_process = list(grouped_rows.keys())
    if file_limit is not None:
        files_to_process = files_to_process[:file_limit]
    
    stats = {'total_files': len(files_to_process), 'successful': 0, 'failed': 0}
    
    for i, file_path in enumerate(files_to_process, 1):
        pipeline_logger.info(f"\n[{i}/{len(files_to_process)}] Processing: {os.path.basename(file_path)}")
        try:
            success = process_grouped_audio_file(file_path, grouped_rows[file_path], output_dir)
            if success:
                stats['successful'] += 1
            else:
                stats['failed'] += 1
        except Exception as e:
            pipeline_logger.opt(exception=True).error(f"Error processing {os.path.basename(file_path)}: {e}")
            stats['failed'] += 1
    
    return stats

