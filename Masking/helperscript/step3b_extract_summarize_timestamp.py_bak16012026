            .perfect {{ background-color: #d4edda; }}
            .partial {{ background-color: #fff3cd; }}
            .mismatch {{ background-color: #f8d7da; }}
            .only {{ background-color: #e2e3e5; }}
            .match-row {{ display: flex; margin: 5px 0; }}
            .timestamp {{ flex: 1; padding: 5px; border: 1px solid #ddd; }}
