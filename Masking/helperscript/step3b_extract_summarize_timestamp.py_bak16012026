PROJECT_ID = os.getenv("PROJECT_ID", "")
API_BASE = os.getenv("JAMAI_API_BASE", "http://localhost:6969/api")

def _safe_json(text: str) -> Any:
    if not text:
        return None
    # 1. Parse with JSON5
    try:
        return json5.loads(text)
    except Exception as e:
        logger.error(f"Failed to parse JSON: {text}, err: {str(e)}")
        return None
    
def _extract_timestamps(timestamp_data):
    """Extract the JSON array of timestamps from the Combined field."""
    if not timestamp_data:
        return []
    pattern = r'<Conclusion>\s*(.*?)\s*</Conclusion>'
    match = re.search(pattern, timestamp_data, re.DOTALL | re.IGNORECASE) # Case-insensitive tag matching
    if not match:
        logger.warning("    No Machine_Readable_Output found in timestamp data")
        return []
    json_str = match.group(1).strip()
    timestamps = _safe_json(json_str)
    return timestamps

def _extract_value(field: Any) -> Any:
    return field.get("value") if isinstance(field, dict) else field

def _within_time(time: float, start_time: float, end_time: float, tolerance: float = 1) -> bool:
    """Check if time is within start_time and end_time, inclusive. with a tolerance of 1s"""
    return start_time - tolerance <= time <= end_time + tolerance

def _log_dict(data, message="", level="info"):
    """Pretty print dictionary with Loguru"""
    formatted = json.dumps(data, indent=2, default=str)
    if message:
        formatted = f"{message}\n{formatted}"
    
    if level == "debug":
        logger.debug("{}", formatted)
    elif level == "warning":
        logger.warning("{}", formatted)
    elif level == "error":
        logger.error("{}", formatted)
    else:
        logger.info("{}", formatted)

def _get_table_tows(table_id: str) -> list[dict[str, Any]]:
    jamai = JamAI(project_id=PROJECT_ID, api_base=API_BASE)
    try:
        table = jamai.table.get_table(table_type=p.TableType.action, table_id=table_id)
        table_total_rows = table.num_rows
        offset = 0
        _row_num = 0
        all_rows: list[dict[str, Any]] = []
        while _row_num < table_total_rows:
            rows = jamai.table.list_table_rows(
                table_type=p.TableType.action,
                table_id=table_id,
                columns=[
                    "file_path",
                    "Timestamp_to_mask",
                ],
                offset=offset,
            )
            all_rows.extend(rows.items)
            offset += len(rows.items)
            _row_num += len(rows.items)
        return all_rows
    except ResourceNotFoundError:
        raise ResourceNotFoundError(f"Table '{table_id}' not found")
    
def _merge_timestamp(timestamps: List[Dict[str, Any]]):
    """Merge overlapping timestamps."""
    if not timestamps:
        return []
    
    # Sort by start time
    timestamps = sorted(timestamps, key=lambda x: x.get("start", 0))

    timestamps = [ts for ts in timestamps if ts.get("start", None) and ts.get("end", None)]
    
    merged = []
    current = timestamps[0].copy()
    
    for i in range(1, len(timestamps)):
        next_ts = timestamps[i]
        current_end = current.get("end", 0)
        next_start = next_ts.get("start", 0)
        
        # If current and next overlap or are adjacent (within tolerance)
        if current_end + 1 >= next_start:  # 1 second tolerance for adjacency
            # Merge by taking the maximum end time
            current["end"] = max(current_end, next_ts.get("end", 0))
        else:
            merged.append(current)
            current = next_ts.copy()
    
    merged.append(current)
    return merged

def _is_subset(ts1: Dict[str, Any], ts2: Dict[str, Any], tolerance: float = 1.0) -> bool:
    """
    Check if timestamp ts1 is a subset of ts2 (or vice versa) within tolerance.
    Returns True if either timestamp is contained within the other.
    """
    start1, end1 = ts1.get("start", 0), ts1.get("end", 0)
    start2, end2 = ts2.get("start", 0), ts2.get("end", 0)
    
    # Check if ts1 is subset of ts2 (with tolerance)
    if (start1 + tolerance >= start2 and end1 - tolerance <= end2):
        return True
    
    # Check if ts2 is subset of ts1 (with tolerance)
    if (start2 + tolerance >= start1 and end2 - tolerance <= end1):
        return True
    
    return False

def _timestamps_match(ts1: Dict[str, Any], ts2: Dict[str, Any], tolerance: float = 1.0) -> bool:
    """
    Check if two timestamps match based on start/end times with tolerance.
    They match if either is a subset of the other.
    """
    return _is_subset(ts1, ts2, tolerance)

def _process_table(table_id: str) -> Dict[str, Any]:
    """Process a single table and return the summary."""
    table_rows = _get_table_tows(table_id)
    grouped = {}
    for r in table_rows:
        key = _extract_value(r.get("file_path")).split("/")[-1]
        if key:
            grouped.setdefault(key, []).append(r)
    logger.info(f"Found {len(grouped)} unique file groups to process.")
    
    summary = {}
    for idx, (row_key, chunk_rows) in enumerate(grouped.items(), 1):
        logger.info(f"Processing group {row_key}...")
        summary[row_key] = []
        for r in chunk_rows:
            timestamps = _extract_timestamps(_extract_value(r.get("Timestamp_to_mask")))
            if not timestamps:
                continue
            summary[row_key].extend(timestamps)
        
        # Sort the timestamps by start time
        summary[row_key] = sorted(summary[row_key], key=lambda x: x.get("start", 0))
        # Merge overlapping timestamps
        summary[row_key] = _merge_timestamp(summary[row_key])
    
    return summary

