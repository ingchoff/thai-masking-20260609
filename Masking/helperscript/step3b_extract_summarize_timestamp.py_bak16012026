def _compare_summaries(summary1: Dict[str, Any], summary2: Dict[str, Any]) -> Dict[str, Any]:
    """Compare two summaries and return comparison results with side-by-side structure."""
    comparison = {
        "metadata": {
            "table1_files": len(summary1),
            "table2_files": len(summary2),
            "comparison_date": datetime.now().isoformat()
        },
        "files": {},
        "summary": {
            "total_files": 0,
            "files_in_both": 0,
            "files_only_in_table1": 0,
            "files_only_in_table2": 0,
            "perfect_matches": 0,
            "partial_matches": 0,
            "complete_mismatches": 0
        }
    }
    
    all_files = set(summary1.keys()) | set(summary2.keys())
    comparison["summary"]["total_files"] = len(all_files)
    
    for file_path in sorted(all_files):  # Sort for consistent ordering
        file_data = {
            "side_by_side": {
                "table1_timestamps": summary1.get(file_path, []),
                "table2_timestamps": summary2.get(file_path, []),
                "matches": []
            },
            "status": "",
            "stats": {
                "table1_count": len(summary1.get(file_path, [])),
                "table2_count": len(summary2.get(file_path, [])),
                "matched_count": 0,
                "unmatched_table1_count": 0,
                "unmatched_table2_count": 0
            }
        }
        
        if file_path in summary1 and file_path in summary2:
            comparison["summary"]["files_in_both"] += 1
            
            ts1_list = summary1[file_path]
            ts2_list = summary2[file_path]
            
            # Create side-by-side comparison
            matched_ts1 = set()
            matched_ts2 = set()
            
            for i, ts1 in enumerate(ts1_list):
                best_match = None
                best_match_idx = -1
                
                for j, ts2 in enumerate(ts2_list):
                    if j not in matched_ts2 and _timestamps_match(ts1, ts2):
                        # Find the best match (most overlapping)
                        overlap = _calculate_overlap(ts1, ts2)
                        if best_match is None or overlap > best_match["overlap"]:
                            best_match = {
                                "table2_index": j,
                                "table2_timestamp": ts2,
                                "overlap": overlap
                            }
                            best_match_idx = j
                
                if best_match:
                    matched_ts1.add(i)
                    matched_ts2.add(best_match_idx)
                    file_data["side_by_side"]["matches"].append({
                        "table1": ts1,
                        "table2": best_match["table2_timestamp"],
                        "overlap_percentage": best_match["overlap"]
                    })
            
            # Add unmatched timestamps
            for i, ts1 in enumerate(ts1_list):
                if i not in matched_ts1:
                    file_data["side_by_side"]["matches"].append({
                        "table1": ts1,
                        "table2": None,
                        "overlap_percentage": 0
                    })
            
            for j, ts2 in enumerate(ts2_list):
                if j not in matched_ts2:
                    file_data["side_by_side"]["matches"].append({
                        "table1": None,
                        "table2": ts2,
                        "overlap_percentage": 0
                    })
            
            # Sort matches by start time for better readability
            file_data["side_by_side"]["matches"].sort(key=lambda x: 
                x["table1"]["start"] if x["table1"] else 
                x["table2"]["start"] if x["table2"] else 0)
            
            # Update stats
            file_data["stats"]["matched_count"] = len(matched_ts1)
            file_data["stats"]["unmatched_table1_count"] = len(ts1_list) - len(matched_ts1)
            file_data["stats"]["unmatched_table2_count"] = len(ts2_list) - len(matched_ts2)
            
            # Determine status
            if file_data["stats"]["unmatched_table1_count"] == 0 and file_data["stats"]["unmatched_table2_count"] == 0:
                file_data["status"] = "perfect_match"
                comparison["summary"]["perfect_matches"] += 1
            elif file_data["stats"]["matched_count"] > 0:
                file_data["status"] = "partial_match"
                comparison["summary"]["partial_matches"] += 1
            else:
                file_data["status"] = "complete_mismatch"
                comparison["summary"]["complete_mismatches"] += 1
                
        elif file_path in summary1:
            comparison["summary"]["files_only_in_table1"] += 1
            file_data["status"] = "only_in_table1"
            # Add all table1 timestamps as unmatched
            for ts1 in summary1[file_path]:
                file_data["side_by_side"]["matches"].append({
                    "table1": ts1,
                    "table2": None,
                    "overlap_percentage": 0
                })
        else:
            comparison["summary"]["files_only_in_table2"] += 1
            file_data["status"] = "only_in_table2"
            # Add all table2 timestamps as unmatched
            for ts2 in summary2[file_path]:
                file_data["side_by_side"]["matches"].append({
                    "table1": None,
                    "table2": ts2,
                    "overlap_percentage": 0
                })
        
        comparison["files"][file_path] = file_data
    
    return comparison

def _calculate_overlap(ts1: Dict[str, Any], ts2: Dict[str, Any]) -> float:
    """Calculate overlap percentage between two timestamps."""
    start1, end1 = ts1.get("start", 0), ts1.get("end", 0)
    start2, end2 = ts2.get("start", 0), ts2.get("end", 0)
    
    overlap_start = max(start1, start2)
    overlap_end = min(end1, end2)
    
    if overlap_start >= overlap_end:
        return 0.0
    
    overlap_duration = overlap_end - overlap_start
    ts1_duration = end1 - start1
    ts2_duration = end2 - start2
    
    # Return the maximum overlap percentage relative to either timestamp
    return max(overlap_duration / ts1_duration, overlap_duration / ts2_duration) * 100

def main(args):
    if args.compare_table:
        # Comparison mode
        logger.info(f"Processing first table: {args.step3b}")
        summary1 = _process_table(args.step3b)
        
        logger.info(f"Processing second table: {args.compare_table}")
        summary2 = _process_table(args.compare_table)
        
        logger.info("Comparing tables...")
        comparison_result = _compare_summaries(summary1, summary2)
        
        # Save comparison to JSON file
        output_file = args.output or "compare.json"
        with open(output_file, 'w', encoding='utf-8') as f:
            json.dump(comparison_result, f, indent=2, ensure_ascii=False, default=str)
        
        logger.info(f"Comparison saved to {output_file}")

        # Generate additional reports if requested
        if args.html_report:
            html_file = args.html_report
            _generate_html_report(comparison_result, html_file)
            logger.info(f"HTML report saved to {html_file}")
        
        # Log summary statistics
        stats = comparison_result["summary"]
        logger.info(f"\nComparison Summary:")
        logger.info(f"  Perfect matches: {stats['perfect_matches']}")
        logger.info(f"  Partial matches: {stats['partial_matches']}")
        logger.info(f"  Complete mismatches: {stats['complete_mismatches']}")
        
    else:
        # Single table mode (original functionality)
        summary = _process_table(args.step3b)
        logger.info(f"Done processing {len(summary)} groups.")
        _log_dict(summary, level="info")
        
        # Generate HTML report for single table if requested
        if args.html_report:
            html_file = args.html_report
            _generate_single_table_html_report(summary, html_file, f"Table {args.step3b}")
            logger.info(f"Single table HTML report saved to {html_file}")

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Summarize the timestamps to be masked for each input voice file."
    )
    parser.add_argument("--step3b", required=True, help="First table ID to process")
    parser.add_argument("--compare-table", help="Second table ID for comparison mode")
    parser.add_argument("--output", "-o", help="Output JSON file for comparison results (default: compare.json)")
    parser.add_argument("--html-report", help="Generate HTML report (works for both single table and comparison modes)")
    
    args = parser.parse_args()

    main(args)
